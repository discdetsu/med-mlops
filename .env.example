# Copy to .env (`make up` does this on first run). Local-only defaults; change for anything shared.

# --- Object storage (RustFS). Containers use S3_ENDPOINT_URL; host tools use S3_HOST_ENDPOINT_URL.
S3_ENDPOINT_URL=http://rustfs:9000
S3_HOST_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cxr-admin
S3_SECRET_KEY=change-me-rustfs
S3_REGION=us-east-1
INFERENCE_RAW_RETENTION_DAYS=30
# Evidently HTML drift reports under artifacts/monitoring/ (the drift_reports rows stay).
MONITORING_REPORT_RETENTION_DAYS=30

# --- PostgreSQL: superuser plus one user per database
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
MLFLOW_DB_PASSWORD=change-me-mlflow
PREFECT_DB_PASSWORD=change-me-prefect
LABELSTUDIO_DB_PASSWORD=change-me-labelstudio

# --- RabbitMQ
RABBITMQ_USER=cxr
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- Serving: Django admin login, and the token workers use for /internal/*
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=change-me-admin
INTERNAL_API_TOKEN=change-me-internal-token
JOB_TIMEOUT_SECONDS=60

# --- full profile
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=change-me-labelstudio
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Alerts (full profile): an incoming webhook for Discord or Slack. Leave both empty to see
# alerts only at http://localhost:9093. Discord wins when both are set.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
