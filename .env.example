# Copy to `.env` and fill in, or run `infra/scripts/init-env.sh` to generate random secrets.
# `.env` is read by docker compose and by `cxr.config.Settings`. Never commit it.

# --- Postgres -------------------------------------------------------------------------
# Superuser, only used by the init script that creates the app/mlflow/airflow databases.
POSTGRES_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me

# --- App (cxr package) ----------------------------------------------------------------
# Defaults point at the compose services published on localhost.
CXR_DB_HOST=localhost
CXR_DB_PORT=5432
CXR_DB_NAME=app
CXR_DB_USER=app
CXR_DB_PASSWORD=change-me

# Also used as the RustFS root credentials.
CXR_S3_ENDPOINT_URL=http://localhost:9000
CXR_S3_ACCESS_KEY=change-me
CXR_S3_SECRET_KEY=change-me
CXR_S3_BUCKET=cxr

CXR_MLFLOW_TRACKING_URI=http://localhost:5000

# --- RabbitMQ -------------------------------------------------------------------------
RABBITMQ_USER=cxr
RABBITMQ_PASSWORD=change-me

# --- Airflow --------------------------------------------------------------------------
# Generate with: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
