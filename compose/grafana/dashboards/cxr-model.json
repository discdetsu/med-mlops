      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (model_version, verdict) (increase(cxr_feedback_total{model_version=~\"$model_version\"}[1h]))",
          "legendFormat": "v{{model_version}} {{verdict}}"
